{
  "$name": "G.A Auto Elétrica — Design Tokens",
  "$version": "1.0.0",
  "$description": "Fonte da verdade do sistema. Os valores aqui são espelhados em src/index.css como variáveis HSL para o Tailwind.",

  "color": {
    "ink": {
      "$value": "#101114",
      "$hsl": "225 11% 7%",
      "$use": "Texto principal, botões primários, superfícies escuras (hero, cabeçalho da oficina).",
      "contrast": { "sobre-branco": "19.1:1 (AAA)", "sobre-mist": "17.9:1 (AAA)", "sobre-volt": "11.9:1 (AAA)" },
      "scale": { "900": "#101114", "800": "#1A1D21", "700": "#2A2E34", "600": "#3C4149" }
    },
    "slate": {
      "$value": "#5B6068",
      "$hsl": "217 7% 38%",
      "$use": "Texto secundário, legendas, rótulos, ícones inativos.",
      "contrast": { "sobre-branco": "6.3:1 (AA)", "sobre-mist": "5.9:1 (AA)" }
    },
    "mist": {
      "$value": "#F2F3F5",
      "$hsl": "220 13% 96%",
      "$use": "Fundo da página, estados hover de linhas, superfícies de chip neutro.",
      "scale": { "100": "#F8F9FA", "200": "#F2F3F5", "300": "#E8EAED", "400": "#E2E4E8 (borda)" }
    },
    "volt": {
      "$value": "#FFC400",
      "$hsl": "46 100% 50%",
      "$use": "Acento da marca (raio do logo). Status 'Em andamento'. Foco sobre superfícies escuras.",
      "regra": "NUNCA como texto sobre branco (1.6:1). Sempre como preenchimento com texto ink por cima."
    },
    "signal": {
      "$value": "#0C7A42",
      "$hsl": "150 82% 26%",
      "$use": "Status 'Concluído', confirmações, validação bem-sucedida.",
      "contrast": { "sobre-branco": "4.9:1 (AA)", "texto-branco-sobre-ele": "4.3:1 (AA large / UI)" }
    },
    "alert": {
      "$value": "#C4302B",
      "$hsl": "2 64% 47%",
      "$use": "Erros de formulário, status 'Cancelado', ações destrutivas.",
      "contrast": { "sobre-branco": "5.5:1 (AA)", "texto-branco-sobre-ele": "5.2:1 (AA)" }
    },
    "$absolutos": { "white": "#FFFFFF", "black": "#000000" }
  },

  "typography": {
    "display": {
      "family": "Archivo",
      "fallback": "system-ui, -apple-system, Segoe UI, sans-serif",
      "weights": [600, 700, 800],
      "$use": "Títulos de tela, números grandes, placa do veículo.",
      "tracking": "-0.02em"
    },
    "ui": {
      "family": "Inter",
      "fallback": "system-ui, -apple-system, Segoe UI, sans-serif",
      "weights": [400, 500, 600],
      "$use": "Todo o resto: corpo, rótulos, botões, tabelas."
    },
    "scale": {
      "display-xl": { "size": "40px", "line": "44px", "weight": 800, "face": "display" },
      "display-l":  { "size": "32px", "line": "36px", "weight": 700, "face": "display" },
      "display-m":  { "size": "24px", "line": "30px", "weight": 700, "face": "display" },
      "title":      { "size": "18px", "line": "24px", "weight": 600, "face": "ui" },
      "body":       { "size": "16px", "line": "24px", "weight": 400, "face": "ui" },
      "small":      { "size": "14px", "line": "20px", "weight": 400, "face": "ui" },
      "caption":    { "size": "12px", "line": "16px", "weight": 500, "face": "ui", "tracking": "0.04em" }
    }
  },

  "space": {
    "$grid": "4px",
    "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px",
    "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px", "20": "80px"
  },

  "radius": {
    "sm": "8px",
    "md": "14px",
    "lg": "24px",
    "$regra": "sm = chips, inputs e botões pequenos. md = botões, cards. lg = painéis e folhas."
  },

  "shadow": {
    "raised":  "0 1px 2px rgba(16,17,20,0.06), 0 2px 8px rgba(16,17,20,0.06)",
    "overlay": "0 2px 6px rgba(16,17,20,0.08), 0 8px 24px rgba(16,17,20,0.12)",
    "$regra": "Dois níveis, só. Card = raised. Modal, dropdown, toast e barra fixa = overlay."
  },

  "motion": {
    "fast": "120ms",
    "base": "180ms",
    "slow": "240ms",
    "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "$regra": "Nada acima de 240ms. Respeita prefers-reduced-motion."
  },

  "status": {
    "pending":     { "rótulo": "Na fila",      "bg": "#E8EAED", "fg": "#101114", "dot": "#5B6068" },
    "in_progress": { "rótulo": "Em andamento", "bg": "#FFC400", "fg": "#101114", "dot": "#101114" },
    "completed":   { "rótulo": "Concluído",    "bg": "#0C7A42", "fg": "#FFFFFF", "dot": "#FFFFFF" },
    "cancelled":   { "rótulo": "Cancelado",    "bg": "#C4302B", "fg": "#FFFFFF", "dot": "#FFFFFF" }
  },

  "focus": {
    "ring": "2px solid",
    "offset": "2px",
    "color-sobre-claro": "#101114",
    "color-sobre-escuro": "#FFC400",
    "$regra": "Todo controle focável mostra anel visível. Contraste mínimo 3:1 contra a superfície."
  },

  "layout": {
    "min-width": "360px",
    "container": "1200px",
    "gutter": { "mobile": "16px", "desktop": "24px" },
    "touch-target": "44px"
  }
}
