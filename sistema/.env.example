# Senha única para entrar no sistema (todas as pessoas da oficina usam esta).
OFICINA_SENHA="troque-esta-senha"

# Segredo usado para assinar o cookie de sessão (qualquer texto longo e aleatório).
SESSAO_SECRET="troque-por-um-texto-aleatorio-longo"

# Criado automaticamente pela Vercel ao conectar a loja do Blob ao projeto:
#   npx vercel blob create-store oficina --access private --region gru1 --yes
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
