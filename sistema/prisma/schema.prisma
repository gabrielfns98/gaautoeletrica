generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Prioridade {
  normal
  urgente
}

enum StatusOS {
  na_fila
  em_servico
  aguardando_peca
  pronta
  entregue
}

enum TipoItem {
  peca_comprada
  peca_reparada
  mao_de_obra
}

model Cliente {
  id        String   @id @default(cuid())
  nome      String
  telefone  String
  obs       String?
  criadoEm  DateTime @default(now())
  vans      Van[]
}

model Van {
  id        String   @id @default(cuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  placa     String   @unique
  modelo    String
  ano       Int?
  obs       String?
  criadoEm  DateTime @default(now())
  oss       OS[]

  @@index([placa])
}

model OS {
  id    String @id @default(cuid())
  numero Int   @unique @default(autoincrement())

  vanId String
  van   Van    @relation(fields: [vanId], references: [id])

  dataEntrada DateTime   @default(now())
  km          Int?
  prioridade  Prioridade @default(normal)
  status      StatusOS   @default(na_fila)
  fixada      Boolean    @default(false)

  previsaoEntrega DateTime?
  dataEntrega     DateTime?

  problemaRelatado String
  problemaReal     String?
  servicoFeito     String?

  descontoCentavos     Int     @default(0)
  validadeDias         Int     @default(7)
  observacoesOrcamento String?

  itens ItemOS[]

  @@index([status])
  @@index([vanId])
}

model ItemOS {
  id                  String   @id @default(cuid())
  osId                String
  os                  OS       @relation(fields: [osId], references: [id], onDelete: Cascade)
  tipo                TipoItem
  descricao           String
  quantidade          Int      @default(1)
  valorUnitarioCentavos Int    @default(0)
  criadoEm            DateTime @default(now())

  @@index([osId])
}
